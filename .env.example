# ===== Database (compose 내부 postgres 서비스) =====
POSTGRES_USER=jobroute
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jobroute
# 아래 호스트는 compose 서비스명(postgres) 그대로 둡니다
DATABASE_URL=postgres://jobroute:change-me-strong-password@postgres:5432/jobroute?schema=public

# ===== Redis (compose 내부 redis 서비스) =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== App =====
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# 전체 피드백을 조회할 수 있는 관리자 계정 이메일
ADMIN_EMAIL=
# 프론트(Vercel) 주소
FRONTEND_URL=https://your-frontend.vercel.app
# 백엔드 공개 도메인 (Caddy HTTPS 발급 대상)
DOMAIN=api.yourdomain.com

# ===== AI =====
OPENAI_API_KEY=
VOYAGE_API_KEY=

# ===== Mail (Gmail 앱 비밀번호) =====
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== OAuth (콜백은 반드시 공개 https 주소) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://api.yourdomain.com/auth/kakao/callback
